NODE_ENV=development
PORT=3000

MASTER_DB_HOST=localhost
MASTER_DB_PORT=3306
MASTER_DB_NAME=billing_master
MASTER_DB_USER=root
MASTER_DB_PASSWORD=

TENANT_DB_HOST=localhost
TENANT_DB_PORT=3306
TENANT_DB_USER=root
TENANT_DB_PASSWORD=

JWT_SECRET=change-this-jwt-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PLATFORM_ADMIN_EMAIL=admin@billingpos.com
PLATFORM_ADMIN_PASSWORD=Admin@123

CORS_ORIGINS=http://localhost:8081,http://localhost:3001,http://10.0.2.2:8081
UPLOAD_PATH=./uploads
TRUST_PROXY=0

# Shopify integration (leave SHOPIFY_API_KEY empty to disable)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_inventory,write_inventory,read_locations,read_orders
SHOPIFY_API_VERSION=2026-07
# Public HTTPS URL Shopify can reach (use a tunnel such as ngrok for local testing)
SHOPIFY_APP_URL=
# 32-byte key, base64 or hex: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_MOBILE_RETURN_URL=kdspoz://integrations/shopify
SHOPIFY_WORKER=1
SHOPIFY_AUTO_SYNC_HOURS=12
