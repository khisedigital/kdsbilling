NODE_ENV=production
PORT=3008

# Nginx strips /kdspozr (proxy_pass http://127.0.0.1:3008/;).
# Express always listens at /admin and /api/v1.
# This value only prefixes admin HTML/JS/CSS URLs in the browser.
PUBLIC_BASE_PATH=/kdspozr

MASTER_DB_HOST=your-db-host
MASTER_DB_PORT=3306
MASTER_DB_NAME=billing_master
MASTER_DB_USER=billing_app
MASTER_DB_PASSWORD=strong-password-here

TENANT_DB_HOST=your-db-host
TENANT_DB_PORT=3306
TENANT_DB_USER=khisedigital
TENANT_DB_PASSWORD=strong-password-here
# Required on shared hosting: DBs this user is allowed to own, e.g. khisedigital_t_shopcode
TENANT_DB_PREFIX=khisedigital_

JWT_SECRET=generate-64-char-random-secret
JWT_REFRESH_SECRET=generate-another-64-char-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PLATFORM_ADMIN_EMAIL=admin@khisedigital.info
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=change-strong-password

# Comma-separated. The web panel (https://billing.khisedigital.in) and app://kdspoz are always allowed in code.
CORS_ORIGINS=https://khisedigital.info
UPLOAD_PATH=/var/www/kdsposr/uploads

TRUST_PROXY=1

# Shopify integration (Shopify Partner / Dev Dashboard app credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_inventory,write_inventory,read_locations,read_orders
SHOPIFY_API_VERSION=2026-07
SHOPIFY_APP_URL=https://khisedigital.info/kdspozr
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  (never change once tokens are stored)
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_MOBILE_RETURN_URL=kdspoz://integrations/shopify
SHOPIFY_WORKER=1
SHOPIFY_AUTO_SYNC_HOURS=12
