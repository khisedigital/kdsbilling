+++ b/node_modules/react-native-thermal-receipt-printer/ios/PrinterSDK/PrinterSDKSimulatorStub.m
@@ -0,0 +1,97 @@
+#if TARGET_OS_SIMULATOR
+
+#import "PrinterSDK.h"
+
+/**
+ * libPrinterSDK.a only ships device slices (iphoneos arm64). Apple Silicon
+ * simulators need arm64-simulator, so we stub the SDK for simulator builds.
+ * Real Bluetooth / IP printing still works on a physical iPhone.
+ */
+
+NSString *PrinterConnectedNotification = @"PrinterConnectedNotification";
+NSString *PrinterDisconnectedNotification = @"PrinterDisconnectedNotification";
+
+@implementation Printer
+@end
+
+@implementation PrinterSDK
+
++ (PrinterSDK *)defaultPrinterSDK {
+  static PrinterSDK *shared = nil;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    shared = [[PrinterSDK alloc] init];
+  });
+  return shared;
+}
+
+- (void)scanPrintersWithCompletion:(PrinterScanPrintersCallback)callback {
+  (void)callback;
+}
+
+- (void)stopScanPrinters {
+}
+
+- (BOOL)connectIP:(NSString *)ipAddress {
+  (void)ipAddress;
+  return NO;
+}
+
+- (void)connectBT:(Printer *)printer {
+  (void)printer;
+}
+
+- (void)disconnect {
+}
+
+- (void)setPrintWidth:(NSInteger)width {
+  (void)width;
+}
+
+- (void)printText:(NSString *)text {
+  (void)text;
+}
+
+- (void)printTextImage:(NSString *)text {
+  (void)text;
+}
+
+- (void)sendHex:(NSString *)hex {
+  (void)hex;
+}
+
+- (void)printCodeBar:(NSString *)text type:(CodeBarType)type {
+  (void)text;
+  (void)type;
+}
+
+- (void)printQrCode:(NSString *)text {
+  (void)text;
+}
+
+- (void)printImage:(UIImage *)image {
+  (void)image;
+}
+
+- (void)cutPaper {
+}
+
+- (void)beep {
+}
+
+- (void)openCasher {
+}
+
+- (void)setFontSizeMultiple:(NSInteger)multiple {
+  (void)multiple;
+}
