# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Barcode scanning only; keeps VisionCamera's location (photo geotag) code out of the app.
$VCEnableLocation = false

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'BillingPOS' do
  config = use_native_modules!

  pod 'KdsPrint', :path => './KdsPrint'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # libPrinterSDK.a is device-only. Never put it in the base OTHER_LDFLAGS
    # (simulator would fail). Only link it for iphoneos. Never replace
    # LIBRARY_SEARCH_PATHS[sdk=iphoneos*] without $(inherited) — that drops KdsPrint.
    printer_sdk_path = '"$(PODS_ROOT)/../../node_modules/react-native-thermal-receipt-printer/ios/PrinterSDK"'
    strip_printer_sdk = lambda do |config|
      %w[OTHER_LDFLAGS OTHER_LIBTOOLFLAGS].each do |key|
        flags = config.build_settings[key]
        next if flags.nil?

        list = flags.is_a?(Array) ? flags.flatten : flags.to_s.split(/\s+/)
        cleaned = list.reject { |flag| flag.to_s.gsub(/["']/, '') == '-lPrinterSDK' }
        config.build_settings[key] = cleaned
      end
      # Clear any previous broken sdk-specific LIBRARY_SEARCH_PATHS overwrite.
      config.build_settings.delete('LIBRARY_SEARCH_PATHS[sdk=iphoneos*]')
      config.build_settings['LIBRARY_SEARCH_PATHS'] = ['$(inherited)', printer_sdk_path]
      config.build_settings['OTHER_LDFLAGS[sdk=iphoneos*]'] = '$(inherited) -lPrinterSDK'
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each { |config| strip_printer_sdk.call(config) }
    end

    installer.aggregate_targets.each do |aggregate|
      aggregate.user_project.native_targets.each do |target|
        target.build_configurations.each { |config| strip_printer_sdk.call(config) }
      end
      aggregate.user_project.save
    end
  end
end
