{
  "name": "kdspoz-retail",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "sync-dev-api-host": "node scripts/sync-dev-api-host.js",
    "prestart": "npm run sync-dev-api-host",
    "preandroid": "npm run sync-dev-api-host",
    "preios": "npm run sync-dev-api-host",
    "android": "for d in $(adb devices | awk 'NR>1 && /device$/ {print $1}'); do adb -s \"$d\" reverse tcp:8081 tcp:8081 2>/dev/null; adb -s \"$d\" reverse tcp:3000 tcp:3000 2>/dev/null; done; react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "postinstall": "patch-package",
    "generate:icons": "bash scripts/generate-app-icons.sh",
    "web": "webpack serve --mode development",
    "web:build": "webpack --mode production",
    "web:dist": "webpack --mode production --env webApi=https://khisedigital.info/kdspozr/api/v1",
    "web:preview": "webpack serve --mode production --env webApi=/api/v1",
    "desktop": "npm run web:build && cd desktop && npm start",
    "desktop:dev": "cd desktop && npm run dev",
    "desktop:mac": "npm run web:build && cd desktop && npm run dist:mac",
    "desktop:win": "npm run web:build && cd desktop && npm run dist:win"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "axios": "^1.7.9",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-blob-util": "^0.24.10",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-image-picker": "^8.2.1",
    "react-native-paper": "^5.13.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.6.0",
    "react-native-share": "^12.0.9",
    "react-native-thermal-receipt-printer": "^1.1.5",
    "react-native-vector-icons": "^10.2.0",
    "react-native-vision-camera": "^4.6.4",
    "react-native-web": "^0.21.4",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-loader": "^10.1.1",
    "eslint": "^8.19.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
