{
  "name": "kdspoz-retail-desktop",
  "productName": "KDSPOZ Retail",
  "version": "1.2.3",
  "description": "KDSPOZ Retail billing for Windows and macOS",
  "author": "Khise Digital Solution Pvt Ltd <info@khisedigital.in>",
  "homepage": "https://khisedigital.info",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "KDS_DESKTOP_DEV_URL=http://localhost:8090 electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --ia32",
    "dist:all": "electron-builder --mac --win --ia32"
  },
  "devDependencies": {
    "electron": "43.8.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kdspoz.retail.desktop",
    "productName": "KDSPOZ Retail",
    "copyright": "Copyright © 2026 Khise Digital Solution Pvt Ltd",
    "electronVersion": "43.8.6",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "rawPrint.js",
      "app/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "dmg": {
      "artifactName": "KDSPOZ-Retail-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "KDSPOZ-Retail-${version}-windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "KDSPOZ Retail",
      "artifactName": "KDSPOZ-Retail-Setup-${version}-windows.${ext}"
    },
    "portable": {
      "artifactName": "KDSPOZ-Retail-${version}-windows-portable.${ext}"
    }
  }
}
